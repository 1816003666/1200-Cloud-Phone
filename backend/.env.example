# 复制为 .env 后修改。生产环境务必改掉带 * 的默认值。

# 基础
SECRET_KEY=dev-secret-change-me
APP_NAME=CloudPhoneBoard

# 数据库：本地用 SQLite 免 Docker；生产改成 Postgres
# DATABASE_URL=postgresql+psycopg2://cpb:cpb@localhost:5432/cpb
DATABASE_URL=sqlite:///cloud_phone.db

# JWT *（生产必须用强随机值）
JWT_SECRET=change-me-in-production-please
JWT_EXPIRE_HOURS=12

# 设备编排后端：simulator(免Docker) / redroid(真容器)
DEVICE_BACKEND=simulator

# CORS：生产写死前端域名，不要用 *
CORS_ORIGINS=*

# 初始管理员
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123456
SEED_SUPERADMIN_USERNAME=root
SEED_SUPERADMIN_PASSWORD=Root@123456
